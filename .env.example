# Copy to .env and edit.  docker-compose reads this file for both services.

# --- Security -------------------------------------------------------------
# REQUIRED for internet exposure. Empty = no login (local use only).
APP_PASSWORD=change-me-to-a-long-random-passphrase
# Optional: signs session cookies. Leave empty to derive it from APP_PASSWORD.
SECRET_KEY=
# Session lifetime in hours.
SESSION_HOURS=168

# --- Cloudflare tunnel ----------------------------------------------------
# Token from Zero Trust > Networks > Tunnels > your tunnel (see README).
TUNNEL_TOKEN=

# --- Engine ---------------------------------------------------------------
# chatterbox (GPU) or fake (tone generator, for tests / UI development)
TTS_ENGINE=chatterbox
# multilingual (23 languages, v3), english, or turbo (English, fastest, [laugh] tags)
CHATTERBOX_MODEL=multilingual
# auto, cuda or cpu
DEVICE=auto
# Load the model at startup instead of on the first request.
PRELOAD_MODEL=1

# --- Limits ---------------------------------------------------------------
MAX_TEXT_CHARS=5000
MAX_CHUNK_CHARS=300
MAX_UPLOAD_MB=50
MAX_REFERENCE_SECONDS=30
MIN_REFERENCE_SECONDS=1
# Finished generations kept in history (older ones and their audio are pruned).
HISTORY_LIMIT=200
